// SiamEZ Platform - PostgreSQL schema
// Prisma: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon pooler does not support session advisory locks used by migrate.
  // Set DIRECT_URL to the non-pooler host (strip "-pooler" from the hostname).
  directUrl = env("DIRECT_URL")
}

// ----- Users & Auth -----

enum UserRole {
  admin
  staff
  customer
  freelancer
  company
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime? @map("email_verified")
  passwordHash   String?   @map("password_hash")
  name           String?
  phone          String?
  image          String?
  timezone       String?
  preferredLocale String?  @map("preferred_locale")
  notificationPreferences Json? @map("notification_preferences")
  expoPushToken  String?   @map("expo_push_token")
  lastLoginAt    DateTime? @map("last_login_at")
  role           UserRole  @default(customer)
  active         Boolean   @default(true)
  address        String?
  notes          String?   @db.Text
  /// Integer PK from siam-ez.com/admin clients.php
  legacyCustomerId Int?    @unique @map("legacy_customer_id")
  /// Integer PK from siam-ez.com/admin staff.php
  legacyStaffId    Int?    @unique @map("legacy_staff_id")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  accounts       Account[]
  sessions       Session[]
  casesAsClient  Case[]            @relation("CaseClient")
  staffAssignments StaffAssignment[]
  caseNotes      CaseNote[]
  documents      Document[]        @relation("DocumentUploader")
  invoices       Invoice[]         @relation("InvoiceCustomer")
  eventsAsClient Event[]           @relation("EventClient")
  eventsAsStaff  Event[]           @relation("EventStaff")
  salesVehiclesCreated SalesVehicle[]
  salesPropertiesCreated SalesProperty[]
  freelancerProfile   FreelancerProfile?
  company             Company?
  jobsPosted          Job[]              @relation("JobPostedBy")
  jobsAsFreelancer    Job[]              @relation("JobFreelancer")
  marketplaceJobs     MarketplaceJob[]   @relation("MarketplaceJobFreelancer")
  jobApplications     JobApplication[]   @relation("JobApplicationFreelancer")
  reviewsAsClient     Review[]           @relation("ReviewClient")
  reviewsAsFreelancer Review[]           @relation("ReviewFreelancer")
  savedListings       SavedListing[]
  listingViews        ListingView[]
  compareItems        CompareItem[]
  goals               Goal[]
  lifeEventProgress   LifeEventProgress[]
  workflowRuns        WorkflowRun[]
  workflowStepApprovals WorkflowStepRun[] @relation("WorkflowStepApprover")
  listingEnquiries    ListingEnquiry[]
  savedSearches       SavedSearch[]
  featureFlagsUpdated FeatureFlag[] @relation("FeatureFlagUpdater")
  quotes              Quote[]            @relation("QuoteCustomer")
  quotesAdjusted      Quote[]            @relation("QuoteAdjustedBy")
  vehicleLeadsAssigned VehicleLead[]     @relation("VehicleLeadAssignee")
  vehicleLeadNotes     VehicleLeadNote[]
  vehicleReferralTokens VehicleLeadReferralToken[]
  vehicleStatusChanges VehicleLeadStatusHistory[] @relation("VehicleLeadStatusActor")
  vehicleSocialApprovals VehicleSocialContent[] @relation("VehicleSocialApprover")
  vehicleSocialPosts VehicleSocialPost[] @relation("VehicleSocialPoster")
}

enum FreelancerVerificationStatus {
  pending
  verified
  rejected
}

model FreelancerProfile {
  id                 String                       @id @default(cuid())
  userId             String                       @unique @map("user_id")
  /// URL-safe public username (e.g. /freelancers/sam-translator). Null until claimed.
  slug               String?                      @unique
  isPublic           Boolean                      @default(false) @map("is_public")
  /// Professional headline, e.g. "Certified Translator"
  title              String?
  skills             String[]                     @default([])
  bio                String?                      @db.Text
  /// Hourly rate in smallest currency unit (satang). Null = not listed.
  hourlyRate         Int?                         @map("hourly_rate")
  /// Structured service offerings: [{ title, description?, price? (satang), currency? }]
  services           Json                         @default("[]")
  verificationStatus FreelancerVerificationStatus @default(pending) @map("verification_status")
  isSpecialMember    Boolean                      @default(false) @map("is_special_member")
  averageRating      Float                        @default(0) @map("average_rating")
  totalReviews       Int                          @default(0) @map("total_reviews")
  expoPushToken      String?                      @map("expo_push_token")
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isPublic])
  @@map("freelancer_profiles")
}

// ----- Corporate / Company tier -----

enum JobPostingStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum JobApplicationStatus {
  PENDING
  HIRED
  DECLINED
}

enum AdCampaignStatus {
  PENDING
  ACTIVE
  PAUSED
}

model Company {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  slug         String   @unique
  companyName  String   @map("company_name")
  logo         String?
  bannerImage  String?  @map("banner_image")
  website      String?
  description  String?  @db.Text
  industry     String?
  companySize  String?  @map("company_size")
  taxId        String?  @map("tax_id")
  address      String?
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPostings  JobPosting[]
  adCampaigns  AdCampaign[]

  @@map("companies")
}

model JobPosting {
  id             String           @id @default(cuid())
  companyId      String           @map("company_id")
  title          String
  description    String           @db.Text
  budget         Int
  currency       String           @default("THB")
  requiredSkills String[]         @default([]) @map("required_skills")
  status         JobPostingStatus @default(OPEN)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([companyId, status])
  @@index([status])
  @@map("job_postings")
}

model JobApplication {
  id           String               @id @default(cuid())
  jobPostingId String               @map("job_posting_id")
  freelancerId String               @map("freelancer_id")
  coverNote    String?              @map("cover_note") @db.Text
  status       JobApplicationStatus @default(PENDING)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  freelancer User       @relation("JobApplicationFreelancer", fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([jobPostingId, freelancerId])
  @@index([freelancerId])
  @@index([jobPostingId, status])
  @@map("job_applications")
}

model AdCampaign {
  id          String           @id @default(cuid())
  companyId   String           @map("company_id")
  title       String
  imageUrl    String           @map("image_url")
  targetUrl   String           @map("target_url")
  budget      Int
  dailyLimit  Int?             @map("daily_limit")
  impressions Int              @default(0)
  clicks      Int              @default(0)
  status      AdCampaignStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([status])
  @@map("ad_campaigns")
}

enum AssignmentSource {
  internal
  freelancer
}

enum JobStatus {
  open
  in_progress
  completed_awaiting_review
  approved
  completed
}

/// Step-level progress for driver-license and vehicle-registration marketplace jobs.
enum TrackingStatus {
  DOCUMENTS_PENDING
  APPOINTMENT_SET
  DLT_EXAM_PREP
  LICENSE_ISSUED
  POR_ROR_BOR_PAID
  DLT_INSPECTION
  PLATES_ISSUED
  DELIVERED
}

model Job {
  id                      String           @id @default(cuid())
  title                   String
  description             String           @db.Text
  postedById              String           @map("posted_by_id")
  freelancerId            String?          @map("freelancer_id")
  serviceId               String?          @map("service_id")
  assignmentSource        AssignmentSource @default(freelancer) @map("assignment_source")
  /** Client-facing / invoice amount (smallest currency unit) */
  amount                  Int
  /** Freelancer payout (smallest currency unit); defaults to amount when unset */
  payoutAmount            Int?             @map("payout_amount")
  currency                String           @default("THB")
  isSpecialMemberOnly     Boolean          @default(false) @map("is_special_member_only")
  enableAutoApproval      Boolean          @default(true) @map("enable_auto_approval")
  status                  JobStatus        @default(open)
  trackingStatus          TrackingStatus?  @map("tracking_status")
  trackingNotes           String?          @map("tracking_notes") @db.Text
  isCurrentlyInTransit    Boolean          @default(false) @map("is_currently_in_transit")
  completionSubmittedAt   DateTime?        @map("completion_submitted_at")
  approvedAt              DateTime?        @map("approved_at")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  postedBy         User                  @relation("JobPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  freelancer       User?                 @relation("JobFreelancer", fields: [freelancerId], references: [id], onDelete: SetNull)
  service          Service?              @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  trackingHistory  JobTrackingHistory[]
  conversation     Conversation?
  review           Review?

  @@index([status])
  @@index([assignmentSource, status])
  @@index([freelancerId, status])
  @@index([postedById])
  @@map("jobs")
}

model JobTrackingHistory {
  id             String         @id @default(cuid())
  jobId          String         @map("job_id")
  status         TrackingStatus
  note           String?        @db.Text
  attachmentUrl  String?        @map("attachment_url")
  attachmentName String?        @map("attachment_name")
  latitude       Float?
  longitude      Float?
  createdAt      DateTime       @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("job_tracking_history")
}

model Review {
  id           String   @id @default(cuid())
  rating       Int
  comment      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  jobId        String   @unique @map("job_id")
  clientId     String   @map("client_id")
  freelancerId String   @map("freelancer_id")

  job        Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  client     User @relation("ReviewClient", fields: [clientId], references: [id], onDelete: Restrict)
  freelancer User @relation("ReviewFreelancer", fields: [freelancerId], references: [id], onDelete: Restrict)

  @@index([freelancerId, createdAt])
  @@index([clientId])
  @@map("reviews")
}

model Conversation {
  id        String   @id @default(cuid())
  jobId     String   @unique @map("job_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  job      Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  receiverId     String   @map("receiver_id")
  content        String   @db.Text
  attachmentUrl  String?  @map("attachment_url")
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ----- Services -----

enum ServiceType {
  fixed   // Pay immediately
  quote   // Request review, admin sets price, client pays later
}

model Service {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  shortDescription String? @map("short_description") @db.VarChar(500)
  description String      @db.Text
  type        ServiceType @default(quote)
  priceAmount Int?        @map("price_amount")   // in smallest currency unit (e.g. cents)
  priceCurrency String?   @map("price_currency") @default("THB")
  // JSON: dynamic form config (questions, required docs, etc.)
  formConfig  Json?       @map("form_config")
  /** Conversion-first payment strategy (10/20/30 + minimums). See ServicePaymentConfig. */
  paymentConfig Json?     @map("payment_config")
  sortOrder   Int         @default(0) @map("sort_order")
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  cases  Case[]
  jobs   Job[]
  quotes Quote[]
}

// ----- Cases (every booking becomes a case) -----

enum CaseStatus {
  new           // Just submitted
  under_review  // Staff reviewing (quote-based)
  quoted        // Quote sent to client
  custom_quote_required
  awaiting_payment
  awaiting_initial_payment
  initial_payment_paid
  paid          // Payment received
  in_progress   // Work in progress
  milestone_due
  pending_docs  // Waiting for client docs
  completed
  cancelled
  refund_pending
  refunded
}

model Case {
  id                   String     @id @default(cuid())
  caseNumber           String     @unique @map("case_number") // e.g. SE-2026-00001
  userId               String?    @map("user_id") // null for guest bookings
  serviceId            String     @map("service_id")
  status               CaseStatus @default(new)
  isGuest              Boolean    @default(false) @map("is_guest")
  guestCheckoutToken   String?    @unique @map("guest_checkout_token") // for secure guest checkout
  guestEmail          String?    @map("guest_email")
  guestName           String?    @map("guest_name")
  guestPhone          String?    @map("guest_phone")
  formData            Json?      @map("form_data")
  postToMarketplace   Boolean    @default(false) @map("post_to_marketplace")
  /// Integer PK from siam-ez.com/admin jobs.php (same id as operations bookings)
  legacyJobId         Int?       @unique @map("legacy_job_id")
  /// Order number from payments.php (e.g. BOOK-67)
  legacyOrderNumber   String?    @unique @map("legacy_order_number")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  completedAt         DateTime?  @map("completed_at")

  user            User?            @relation("CaseClient", fields: [userId], references: [id], onDelete: SetNull)
  service         Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  quotes          Quote[]
  payments        Payment[]
  documents       Document[]
  staffAssignments StaffAssignment[]
  caseNotes       CaseNote[]
  invoices        Invoice[]
  events          Event[]
  marketplaceJob  MarketplaceJob?
  workflowRuns    WorkflowRun[] @relation("WorkflowRunLinkedCase")
  paymentMilestones PaymentMilestone[]
  vehicleLead     VehicleLead?
}

enum MarketplaceJobStatus {
  OPEN
  ASSIGNED
  COMPLETED
  CANCELLED
}

model MarketplaceJob {
  id            String               @id @default(cuid())
  caseId        String               @unique @map("case_id")
  status        MarketplaceJobStatus @default(OPEN)
  /** Freelancer payout in smallest currency unit (e.g. satang) */
  budget        Int
  freelancerId  String?              @map("freelancer_id")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  case       Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  freelancer User? @relation("MarketplaceJobFreelancer", fields: [freelancerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([freelancerId])
  @@map("marketplace_jobs")
}

// ----- Quotes (AI / pricing-engine quotes; may exist before a Case) -----

enum QuoteType {
  fixed
  calculated
  range
}

enum QuoteStatus {
  draft
  generated
  sent
  viewed
  accepted
  expired
  cancelled
  rejected
  converted_to_booking
  custom_quote_required
}

model Quote {
  id          String      @id @default(cuid())
  quoteNumber String?     @unique @map("quote_number")
  /** Null until the quote is converted into a booking Case. */
  caseId      String?     @map("case_id")
  serviceId   String      @map("service_id")
  userId      String?     @map("user_id")
  /** Opaque token so guests can resume / accept a quote after login. */
  guestToken  String?     @unique @map("guest_token")

  quoteType QuoteType   @default(calculated) @map("quote_type")
  /** Authoritative total (or mid-range) in smallest currency unit (satang). */
  amount    Int
  currency  String      @default("THB")
  status    QuoteStatus @default(draft)

  /** Structured requirements collected by wizard / AI (never contains AI-invented prices). */
  requirements     Json?
  /** Deterministic pricing engine line items. */
  pricingBreakdown Json? @map("pricing_breakdown")
  subtotal         Int?
  governmentFees   Int?  @map("government_fees")
  addOnsTotal      Int?  @map("add_ons_total")
  discount         Int?  @default(0)
  rangeMin         Int?  @map("range_min")
  rangeMax         Int?  @map("range_max")

  /** Admin override audit trail */
  originalAmount   Int?      @map("original_amount")
  adjustmentAmount Int?      @map("adjustment_amount")
  adjustmentReason String?   @map("adjustment_reason") @db.Text
  adjustedById     String?   @map("adjusted_by_id")
  adjustedAt       DateTime? @map("adjusted_at")
  adminNotes       String?   @map("admin_notes") @db.Text

  notes      String?   @db.Text
  validUntil DateTime? @map("valid_until")
  acceptedAt DateTime? @map("accepted_at")
  viewedAt   DateTime? @map("viewed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  sentAt     DateTime? @map("sent_at")

  /** Conversion-first payment plan (server-calculated; never trust the client). */
  paymentPlan          Json?    @map("payment_plan")
  pricingSnapshot      Json?    @map("pricing_snapshot")
  pricingVersion       String?  @map("pricing_version")
  complexity           String?
  aiConfidence         Float?   @map("ai_confidence")
  requiresHumanReview  Boolean  @default(false) @map("requires_human_review")
  paymentReason        String?  @map("payment_reason") @db.Text
  paymentModel         String?  @map("payment_model")
  initialPercentage    Int?     @map("initial_percentage")
  initialPaymentTotal  Int?     @map("initial_payment_total")
  remainingBalance     Int?     @map("remaining_balance")
  requiredUpfrontCosts Int?     @map("required_upfront_costs")
  paymentChoice        String?  @map("payment_choice") // initial | full

  case       Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  user       User?     @relation("QuoteCustomer", fields: [userId], references: [id], onDelete: SetNull)
  adjustedBy User?     @relation("QuoteAdjustedBy", fields: [adjustedById], references: [id], onDelete: SetNull)
  invoices   Invoice[]
  paymentMilestones PaymentMilestone[]

  @@index([serviceId])
  @@index([status])
  @@index([userId])
  @@index([caseId])
}

// ----- Payments (provider-agnostic: QR, Bank, Wise, Stripe Phase 2) -----

enum PaymentMethod {
  qr      // Thai PromptPay / Bank QR
  bank    // Bank transfer
  wise    // Wise international
  stripe  // Phase 2: online payment
}

enum PaymentStatus {
  submitted   // Proof uploaded, awaiting admin review
  approved    // Admin approved -> invoice paid
  rejected    // Admin rejected
  // Stripe Phase 2: pending, succeeded, failed, refunded
}

model Payment {
  id                    String         @id @default(cuid())
  invoiceId             String         @map("invoice_id")
  caseId                String         @map("case_id") // denormalized for convenience
  amount                Int            // smallest unit
  currency              String         @default("THB")
  method                PaymentMethod
  status                PaymentStatus  @default(submitted)
  proofDocumentId       String?        @unique @map("proof_document_id")
  submittedAt           DateTime       @default(now()) @map("submitted_at")
  approvedAt            DateTime?      @map("approved_at")
  stripePaymentIntentId String?        @unique @map("stripe_payment_intent_id") // Phase 2
  stripeChargeId        String?        @map("stripe_charge_id")
  kind                  InvoiceKind    @default(full)
  idempotencyKey        String?        @unique @map("idempotency_key")
  webhookEventId        String?        @unique @map("webhook_event_id")
  /// Integer PK from siam-ez.com/admin payments.php orders
  legacyOrderId         Int?           @unique @map("legacy_order_id")
  metadata              Json?
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  case          Case      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  proofDocument Document? @relation("PaymentProof", fields: [proofDocumentId], references: [id], onDelete: SetNull)
}

// ----- Documents -----

model Document {
  id           String   @id @default(cuid())
  caseId       String?  @map("case_id") // null = not yet linked to a case
  uploadedBy   String?  @map("uploaded_by") // userId or null for system
  name         String
  storageKey   String   @map("storage_key") // Vercel Blob / S3 key or URL
  mimeType     String?  @map("mime_type")
  size         Int?     // bytes
  documentType String?  @map("document_type") // e.g. passport, contract, payment_proof
  createdAt    DateTime @default(now()) @map("created_at")

  case           Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  uploader       User?   @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  paymentProof   Payment? @relation("PaymentProof")
}

// ----- Staff assignments -----

model StaffAssignment {
  id        String   @id @default(cuid())
  caseId    String   @map("case_id")
  userId    String   @map("user_id")
  role      String   @default("support") // primary, support
  assignedAt DateTime @default(now()) @map("assigned_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@map("staff_assignments")
}

// ----- Case notes (internal + client-visible) -----

model CaseNote {
  id         String   @id @default(cuid())
  caseId     String   @map("case_id")
  userId     String   @map("user_id")
  content    String   @db.Text
  isInternal Boolean  @default(true) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("case_notes")
}

// ----- Invoices -----

enum InvoiceStatus {
  draft                // Admin editing
  unpaid               // Sent to client, awaiting payment
  pending_verification // Proof uploaded, admin reviewing
  paid                 // Payment approved
  rejected             // Payment rejected
}

enum InvoiceKind {
  full
  initial
  milestone
  balance
}

enum InvoicePaymentMethod {
  qr     // Thai PromptPay / Bank QR
  bank   // Bank transfer
  wise   // Wise international
  stripe // Phase 2
}

enum PaymentMilestoneStatus {
  pending
  due
  paid
  waived
}

model PaymentMilestone {
  id           String                  @id @default(cuid())
  quoteId      String                  @map("quote_id")
  caseId       String?                 @map("case_id")
  name         String
  description  String?                 @db.Text
  amount       Int
  percentage   Int
  status       PaymentMilestoneStatus  @default(pending)
  dueCondition String?                 @map("due_condition")
  dueDate      DateTime?               @map("due_date")
  paidAt       DateTime?               @map("paid_at")
  sortOrder    Int                     @default(0) @map("sort_order")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  quote    Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  case     Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  invoices Invoice[]

  @@index([quoteId])
  @@index([caseId])
  @@map("payment_milestones")
}

model Invoice {
  id               String               @id @default(cuid())
  caseId           String               @map("case_id")
  quoteId          String?              @map("quote_id")
  userId           String?              @map("user_id") // billing contact; null for guest invoices
  amount           Int
  currency         String               @default("THB")
  status           InvoiceStatus        @default(draft)
  kind             InvoiceKind          @default(full)
  milestoneId      String?              @map("milestone_id")
  paymentMethod    InvoicePaymentMethod? @map("payment_method") // set when client selects
  dueDate          DateTime?            @map("due_date")
  stripeInvoiceId  String?              @map("stripe_invoice_id") // Phase 2
  lineItems        Json?                @map("line_items")
  attachedPdfUrl   String?              @map("attached_pdf_url") // admin-uploaded or external PDF (blob URL)
  clientAddress    String?              @map("client_address")
  /// Integer PK from siam-ez.com/admin payments.php orders
  legacyOrderId    Int?                 @unique @map("legacy_order_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  sentAt           DateTime?            @map("sent_at")
  paidAt           DateTime?            @map("paid_at")

  case      Case               @relation(fields: [caseId], references: [id], onDelete: Restrict)
  quote     Quote?             @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  user      User?              @relation("InvoiceCustomer", fields: [userId], references: [id], onDelete: SetNull)
  payments  Payment[]
  milestone PaymentMilestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@map("invoices")
}

// ----- Calendar Events -----

enum EventType {
  appointment
  deadline
  milestone
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  start       DateTime
  end         DateTime
  type        EventType @default(appointment)
  allDay      Boolean   @default(false) @map("all_day")
  color       String?   // optional: blue, red, emerald, amber, purple, cyan, pink, orange
  caseId      String?   @map("case_id")
  userId      String?   @map("user_id")   // client
  staffId     String?   @map("staff_id")  // assigned staff
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  case  Case?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  user  User?  @relation("EventClient", fields: [userId], references: [id], onDelete: SetNull)
  staff User?  @relation("EventStaff", fields: [staffId], references: [id], onDelete: SetNull)

  @@map("events")
}

/// Idempotent legacy → new ID map. Do not use names/emails as the join key after import.
model LegacyIdMap {
  id         String   @id @default(cuid())
  entityType String   @map("entity_type")
  legacyId   String   @map("legacy_id")
  newId      String   @map("new_id")
  extra      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([entityType, legacyId])
  @@index([newId])
  @@map("legacy_id_map")
}

// ----- App settings -----

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

enum VehicleCategory {
  car
  motorcycle
}

enum SalesListingStatus {
  available
  reserved
  sold
  /** Bank-transfer boost slip submitted; awaiting staff approval. */
  pending_boost
}

/** Public inventory: dealer (e.g. Sunset Scooters sync) vs private seller listings. */
enum SalesSellerKind {
  dealer
  private
}

model SalesVehicle {
  id               String             @id @default(cuid())
  slug             String             @unique
  title            String
  make             String
  model            String
  year             Int
  mileageKm        Int                @map("mileage_km")
  priceAmount      Int                @map("price_amount")
  /** Prior price when reduced — enables Reduced Price badge (Platform 2.1). */
  previousPriceAmount Int?            @map("previous_price_amount")
  priceCurrency    String             @default("THB") @map("price_currency")
  category         VehicleCategory
  sellerKind       SalesSellerKind    @default(private) @map("seller_kind")
  status           SalesListingStatus @default(available)
  /** Staff/seller verification badge (Platform 2.1). */
  isVerified       Boolean            @default(false) @map("is_verified")
  heroMediaType    String             @default("image") @map("hero_media_type")
  heroImageUrl     String             @map("hero_image_url")
  heroVideoUrl     String?            @map("hero_video_url")
  imageUrls        Json               @map("image_urls")
  videoUrls        Json?              @map("video_urls")
  description      String             @db.Text
  specifications   Json?
  published        Boolean            @default(true)
  isBoosted        Boolean            @default(false) @map("is_boosted")
  boostExpiresAt   DateTime?          @map("boost_expires_at")
  /** Package key, e.g. 1w / 2w / 4w (see SALES_BOOST_PACKAGES). */
  boostTier        String?            @map("boost_tier")
  omiseChargeId    String?            @unique @map("omise_charge_id")
  boostProofDocumentId String?        @map("boost_proof_document_id")
  createdById      String?            @map("created_by_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isBoosted, boostExpiresAt])
  @@index([category, status, published])
  @@index([sellerKind, status, published])
  @@index([make, model, year])
  @@index([isVerified])
  @@map("sales_vehicles")
}

enum PropertyType {
  condo
  house
  townhouse
  land
  commercial
  villa
}

enum PropertyListingType {
  sale
  rent
}

enum PropertyFurnished {
  unfurnished
  partially
  furnished
  not_applicable
}

/** Public real-estate inventory (sale / rent listings). */
model SalesProperty {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String
  propertyType     PropertyType        @map("property_type")
  listingType      PropertyListingType @default(sale) @map("listing_type")
  bedrooms         Int?
  bathrooms        Int?
  areaSqm          Int                 @map("area_sqm")
  landAreaSqm      Int?                @map("land_area_sqm")
  floor            Int?
  yearBuilt        Int?                @map("year_built")
  province         String
  district         String?
  neighborhood     String?
  priceAmount      Int                 @map("price_amount")
  previousPriceAmount Int?             @map("previous_price_amount")
  priceCurrency    String              @default("THB") @map("price_currency")
  sellerKind       SalesSellerKind     @default(private) @map("seller_kind")
  status           SalesListingStatus  @default(available)
  isVerified       Boolean             @default(false) @map("is_verified")
  furnished        PropertyFurnished   @default(not_applicable)
  heroMediaType    String              @default("image") @map("hero_media_type")
  heroImageUrl     String              @map("hero_image_url")
  heroVideoUrl     String?             @map("hero_video_url")
  imageUrls        Json                @map("image_urls")
  videoUrls        Json?               @map("video_urls")
  description      String              @db.Text
  specifications   Json?
  published        Boolean             @default(true)
  isBoosted        Boolean             @default(false) @map("is_boosted")
  boostExpiresAt   DateTime?           @map("boost_expires_at")
  boostTier        String?             @map("boost_tier")
  createdById      String?             @map("created_by_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isBoosted, boostExpiresAt])
  @@index([propertyType, status, published])
  @@index([listingType, status, published])
  @@index([sellerKind, status, published])
  @@index([province, district])
  @@index([isVerified])
  @@map("sales_properties")
}

/**
 * Non-destructive SEO / AI side-store for marketplace listings (Platform Wave M1).
 * Never overwrites SalesVehicle / SalesProperty title, description, images, or price.
 * Linked by polymorphic listingType + listingId (cuid), not by mutating source rows.
 */
enum ListingEnhancementType {
  vehicle
  property
}

model ListingEnhancement {
  id             String                  @id @default(cuid())
  listingType    ListingEnhancementType  @map("listing_type")
  listingId      String                  @map("listing_id")
  aiSummary      String?                 @map("ai_summary") @db.Text
  seoTitle       String?                 @map("seo_title")
  seoDescription String?                 @map("seo_description")
  /** string[] keywords for SEO / search hints */
  keywords       Json?
  schemaJsonLd   Json?                   @map("schema_json_ld")
  enhancedAt     DateTime?               @map("enhanced_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  @@unique([listingType, listingId])
  @@index([listingId])
  @@index([listingType, enhancedAt])
  @@map("listing_enhancements")
}

/**
 * Platform Wave M2 — marketplace engagement (saved / recently viewed / compare).
 * Additive only; never mutates SalesVehicle / SalesProperty source content.
 * ownerKey is "user:<id>" or "anon:<sessionId>" for a single unique constraint.
 */
enum MarketplaceListingType {
  vehicle
  property
}

model SavedListing {
  id                   String                  @id @default(cuid())
  /// "user:<userId>" or "anon:<anonymousSessionId>"
  ownerKey             String                  @map("owner_key")
  userId               String?                 @map("user_id")
  anonymousSessionId   String?                 @map("anonymous_session_id")
  listingType          MarketplaceListingType  @map("listing_type")
  listingId            String                  @map("listing_id")
  createdAt            DateTime                @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ownerKey, listingType, listingId])
  @@index([userId, createdAt])
  @@index([anonymousSessionId, createdAt])
  @@index([listingType, listingId])
  @@map("saved_listings")
}

model ListingView {
  id                   String                  @id @default(cuid())
  ownerKey             String                  @map("owner_key")
  userId               String?                 @map("user_id")
  anonymousSessionId   String?                 @map("anonymous_session_id")
  listingType          MarketplaceListingType  @map("listing_type")
  listingId            String                  @map("listing_id")
  viewedAt             DateTime                @default(now()) @map("viewed_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ownerKey, listingType, listingId])
  @@index([ownerKey, viewedAt])
  @@index([userId, viewedAt])
  @@index([anonymousSessionId, viewedAt])
  @@map("listing_views")
}

/** Compare tray item — application enforces ≤3 per ownerKey; vehicle + property mix allowed. */
model CompareItem {
  id                   String                  @id @default(cuid())
  ownerKey             String                  @map("owner_key")
  userId               String?                 @map("user_id")
  anonymousSessionId   String?                 @map("anonymous_session_id")
  listingType          MarketplaceListingType  @map("listing_type")
  listingId            String                  @map("listing_id")
  createdAt            DateTime                @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ownerKey, listingType, listingId])
  @@index([ownerKey, createdAt])
  @@index([userId])
  @@index([anonymousSessionId])
  @@map("compare_items")
}

/**
 * Platform Wave M4 — Goals + Life Events Engines.
 * Configurable journeys (admin-editable). Additive only; never mutates listing source content.
 */

enum LifeEventRunStatus {
  active
  completed
  abandoned
}

enum LifeEventStepStatus {
  pending
  started
  completed
  skipped
}

enum GoalStatus {
  active
  completed
  cancelled
}

/** Admin-editable life event definition (e.g. "Moving to Thailand"). */
model LifeEvent {
  id            String   @id @default(cuid())
  /// Stable slug/key for seeds and deep links (e.g. moving-to-thailand).
  key           String   @unique
  titleEn       String   @map("title_en")
  titleTh       String?  @map("title_th")
  descriptionEn String?  @map("description_en") @db.Text
  descriptionTh String?  @map("description_th") @db.Text
  active        Boolean  @default(true)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  steps    LifeEventStep[]
  progress LifeEventProgress[]
  goals    Goal[]

  @@index([active, sortOrder])
  @@map("life_events")
}

/**
 * Ordered step within a life event.
 * `target` JSON shape (flexible):
 *   {
 *     serviceSlug?: string,
 *     listingType?: "vehicle" | "property",
 *     listingFilters?: { category?, listingType?, province? },
 *     listingId?: string,  // cuid deep link — never slug
 *     href?: string        // optional path override (locale-agnostic)
 *   }
 */
model LifeEventStep {
  id            String   @id @default(cuid())
  lifeEventId   String   @map("life_event_id")
  titleEn       String   @map("title_en")
  titleTh       String?  @map("title_th")
  descriptionEn String?  @map("description_en") @db.Text
  descriptionTh String?  @map("description_th") @db.Text
  sortOrder     Int      @default(0) @map("sort_order")
  target        Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  lifeEvent    LifeEvent              @relation(fields: [lifeEventId], references: [id], onDelete: Cascade)
  stepProgress LifeEventStepProgress[]

  @@index([lifeEventId, sortOrder])
  @@map("life_event_steps")
}

/** Customer run of a life event (one active/completed run per user + event). */
model LifeEventProgress {
  id          String             @id @default(cuid())
  userId      String             @map("user_id")
  lifeEventId String             @map("life_event_id")
  status      LifeEventRunStatus @default(active)
  startedAt   DateTime           @default(now()) @map("started_at")
  completedAt DateTime?          @map("completed_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifeEvent LifeEvent              @relation(fields: [lifeEventId], references: [id], onDelete: Cascade)
  steps     LifeEventStepProgress[]

  @@unique([userId, lifeEventId])
  @@index([userId, status])
  @@index([lifeEventId])
  @@map("life_event_progress")
}

/** Per-step progress within a customer life event run. */
model LifeEventStepProgress {
  id          String              @id @default(cuid())
  progressId  String              @map("progress_id")
  stepId      String              @map("step_id")
  status      LifeEventStepStatus @default(pending)
  startedAt   DateTime?           @map("started_at")
  completedAt DateTime?           @map("completed_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  progress LifeEventProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  step     LifeEventStep     @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([progressId, stepId])
  @@index([stepId])
  @@map("life_event_step_progress")
}

/** Customer goal capture — optional link to a life event. */
model Goal {
  id                 String     @id @default(cuid())
  userId             String     @map("user_id")
  title              String
  status             GoalStatus @default(active)
  lifeEventId        String?    @map("life_event_id")
  workflowTemplateId String?    @map("workflow_template_id")
  /** 0–100 derived or manually set progress. */
  progressPct        Int        @default(0) @map("progress_pct")
  notes              String?    @db.Text
  completedAt        DateTime?  @map("completed_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifeEvent        LifeEvent?        @relation(fields: [lifeEventId], references: [id], onDelete: SetNull)
  workflowTemplate WorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([lifeEventId])
  @@index([workflowTemplateId])
  @@map("goals")
}

// ----- Platform Wave M7: Universal Workflow templates -----

enum WorkflowRunStatus {
  active
  completed
  cancelled
  rejected
}

enum WorkflowStepRunStatus {
  pending
  in_progress
  awaiting_approval
  approved
  rejected
  completed
  skipped
}

enum WorkflowStepKind {
  info
  action
  booking
  approval
}

/** Reusable cross-division workflow template (additive; does not replace wizards). */
model WorkflowTemplate {
  id            String   @id @default(cuid())
  /// Stable key for seeds / deep links (e.g. vehicle-inspection-booking).
  key           String   @unique
  titleEn       String   @map("title_en")
  titleTh       String?  @map("title_th")
  descriptionEn String?  @map("description_en") @db.Text
  descriptionTh String?  @map("description_th") @db.Text
  active        Boolean  @default(true)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  steps WorkflowTemplateStep[]
  runs  WorkflowRun[]
  goals Goal[]

  @@index([active, sortOrder])
  @@map("workflow_templates")
}

/**
 * Ordered step within a workflow template.
 * `target` JSON (flexible):
 *   {
 *     serviceSlug?: string,
 *     listingType?: "vehicle" | "property",
 *     listingFilters?: { category?, listingType?, province? },
 *     listingId?: string,  // cuid deep link — never slug
 *     href?: string
 *   }
 */
model WorkflowTemplateStep {
  id               String           @id @default(cuid())
  templateId       String           @map("template_id")
  key              String?
  titleEn          String           @map("title_en")
  titleTh          String?          @map("title_th")
  descriptionEn    String?          @map("description_en") @db.Text
  descriptionTh    String?          @map("description_th") @db.Text
  sortOrder        Int              @default(0) @map("sort_order")
  kind             WorkflowStepKind @default(action)
  requiresApproval Boolean          @default(false) @map("requires_approval")
  target           Json             @default("{}")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  template WorkflowTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stepRuns WorkflowStepRun[]

  @@index([templateId, sortOrder])
  @@map("workflow_template_steps")
}

/** Customer (or staff-started) run of a workflow template. */
model WorkflowRun {
  id           String            @id @default(cuid())
  userId       String            @map("user_id")
  templateId   String            @map("template_id")
  status       WorkflowRunStatus @default(active)
  /// Optional Case created from a booking step — set without changing booking API contracts.
  linkedCaseId String?           @map("linked_case_id")
  startedAt    DateTime          @default(now()) @map("started_at")
  completedAt  DateTime?         @map("completed_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   WorkflowTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  linkedCase Case?                @relation("WorkflowRunLinkedCase", fields: [linkedCaseId], references: [id], onDelete: SetNull)
  steps      WorkflowStepRun[]

  @@index([userId, status])
  @@index([templateId])
  @@index([linkedCaseId])
  @@map("workflow_runs")
}

/** Per-step status within a workflow run (includes staff approval gate). */
model WorkflowStepRun {
  id              String                 @id @default(cuid())
  runId           String                 @map("run_id")
  templateStepId  String                 @map("template_step_id")
  status          WorkflowStepRunStatus  @default(pending)
  approvedById    String?                @map("approved_by_id")
  approvedAt      DateTime?              @map("approved_at")
  rejectedAt      DateTime?              @map("rejected_at")
  rejectionReason String?                @map("rejection_reason") @db.Text
  startedAt       DateTime?              @map("started_at")
  completedAt     DateTime?              @map("completed_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  run          WorkflowRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  templateStep WorkflowTemplateStep @relation(fields: [templateStepId], references: [id], onDelete: Cascade)
  approvedBy   User?                @relation("WorkflowStepApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([runId, templateStepId])
  @@index([templateStepId])
  @@index([status])
  @@map("workflow_step_runs")
}

// ----- Platform 2.0: Marketplace listing enquiries -----

model ListingEnquiry {
  id          String   @id @default(cuid())
  listingType String   @map("listing_type") // vehicle | property
  listingId   String   @map("listing_id")
  userId      String?  @map("user_id")
  name        String
  email       String
  phone       String?
  message     String   @db.Text
  status      String   @default("new") // new | read | closed
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([listingType, listingId])
  @@index([userId])
  @@map("listing_enquiries")
}

/**
 * Admin-editable recommendation relationships (Platform 2.0).
 * Defaults also live in src/config/recommendation-graph.ts for offline/tests.
 */
model RecommendationEdge {
  id         String   @id @default(cuid())
  /// Stable seed / upsert key (e.g. motorcycle-registration).
  key        String   @unique
  triggerKey String   @map("trigger_key")
  targetKind String   @map("target_kind") // service | life_event
  targetKey  String   @map("target_key")
  score      Int      @default(50)
  reasonEn   String   @map("reason_en") @db.Text
  reasonTh   String?  @map("reason_th") @db.Text
  active     Boolean  @default(true)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([triggerKey, active])
  @@map("recommendation_edges")
}

// ----- Platform 2.1: Saved searches, feature flags, analytics events -----

/** Customer-saved marketplace filter presets (Phase 3). */
model SavedSearch {
  id                 String                 @id @default(cuid())
  ownerKey           String                 @map("owner_key")
  userId             String?                @map("user_id")
  anonymousSessionId String?                @map("anonymous_session_id")
  listingType        MarketplaceListingType @map("listing_type")
  name               String
  /// Serialized filter/sort query params (JSON object).
  query              Json
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ownerKey, updatedAt])
  @@index([userId, updatedAt])
  @@index([listingType])
  @@map("saved_searches")
}

/** Runtime feature flags — toggle without redeploy (Phase 7). */
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?  @db.Text
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("FeatureFlagUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([enabled])
  @@map("feature_flags")
}

/**
 * Lightweight product analytics events (Phase 6).
 * kind examples: concierge_chat | search_query | listing_enquiry
 */
model PlatformMetricEvent {
  id        String   @id @default(cuid())
  kind      String
  locale    String?
  userId    String?  @map("user_id")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind, createdAt])
  @@index([userId, createdAt])
  @@map("platform_metric_events")
}

/** Idempotency store for Stripe (and other) webhooks. */
model ProcessedWebhookEvent {
  id          String   @id // provider event id
  provider    String   @default("stripe")
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([provider, type])
  @@map("processed_webhook_events")
}

// ----- Vehicle buy / sell leads (quick-link intake) -----

enum VehicleLeadType {
  sell
  buy
}

enum VehicleLeadStatus {
  new
  reviewing
  contacted
  info_confirmed
  price_evaluation
  customer_approved
  listing_or_search
  negotiating
  sold_or_purchased
  completed
  cancelled
}

enum VehicleKind {
  car
  motorcycle
  other
}

enum VehicleMediaKind {
  image
  video
  document
}

enum VehicleSocialStatus {
  not_generated
  draft_generated
  ready_for_review
  approved
  posted
  sold
}

enum VehicleSocialPlatform {
  facebook
  instagram
  tiktok
  line
  whatsapp
  marketplace
}

/**
 * Guest-friendly vehicle buy/sell lead. Distinct from Case so staff can
 * qualify before converting into a booking/job. Converted leads set caseId.
 */
model VehicleLead {
  id            String            @id @default(cuid())
  leadNumber    String            @unique @map("lead_number")
  publicToken   String            @unique @map("public_token")
  type          VehicleLeadType
  status        VehicleLeadStatus @default(new)
  source        String?
  utmSource     String?           @map("utm_source")
  utmMedium     String?           @map("utm_medium")
  utmCampaign   String?           @map("utm_campaign")
  locale        String?

  customerName              String  @map("customer_name")
  customerPhone             String? @map("customer_phone")
  customerLineId            String? @map("customer_line_id")
  customerEmail             String? @map("customer_email")
  preferredContactMethod    String? @map("preferred_contact_method")
  preferredContactTime      String? @map("preferred_contact_time")
  customerLocation          String? @map("customer_location")

  vehicleKind VehicleKind @map("vehicle_kind")
  displayTitle String     @map("display_title")
  province     String?
  city         String?

  /// Whole THB baht (same unit as SalesVehicle.priceAmount).
  askingPrice          Int? @map("asking_price")
  budgetMin            Int? @map("budget_min")
  budgetMax            Int? @map("budget_max")
  officialListingPrice Int? @map("official_listing_price")

  aiEstimatedMin       Int?    @map("ai_estimated_min")
  aiEstimatedMax       Int?    @map("ai_estimated_max")
  aiSuggestedPrice     Int?    @map("ai_suggested_price")
  aiMinAcceptablePrice Int?    @map("ai_min_acceptable_price")
  aiSummary            String? @map("ai_summary") @db.Text
  aiLeadScore          String? @map("ai_lead_score")
  aiAnalysis           Json?   @map("ai_analysis")
  aiCustomerDraft      String? @map("ai_customer_draft") @db.Text

  notes String? @db.Text

  socialStatus VehicleSocialStatus @default(not_generated) @map("social_status")

  assignedStaffId String? @map("assigned_staff_id")
  caseId          String? @unique @map("case_id")
  referralTokenId String? @map("referral_token_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignedStaff  User?                     @relation("VehicleLeadAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  case           Case?                     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  referralToken  VehicleLeadReferralToken? @relation(fields: [referralTokenId], references: [id], onDelete: SetNull)
  vehicle        Vehicle?
  media          VehicleMedia[]
  statusHistory  VehicleLeadStatusHistory[]
  leadNotes      VehicleLeadNote[]
  socialContent  VehicleSocialContent[]
  socialPosts    VehicleSocialPost[]

  @@index([type, status, createdAt])
  @@index([assignedStaffId])
  @@index([source, createdAt])
  @@index([vehicleKind, province])
  @@map("vehicle_leads")
}

model Vehicle {
  id     String @id @default(cuid())
  leadId String @unique @map("lead_id")

  kind         VehicleKind
  make         String?
  model        String?
  year         Int?
  variant      String?
  engineSize   String? @map("engine_size")
  transmission String?
  fuel         String?
  mileageKm    Int?    @map("mileage_km")
  colour       String?
  province     String?
  city         String?

  overallCondition        String? @map("overall_condition")
  accidentHistory         String? @map("accident_history")
  floodDamage             String? @map("flood_damage")
  majorRepairs            String? @map("major_repairs") @db.Text
  engineCondition         String? @map("engine_condition")
  transmissionCondition   String? @map("transmission_condition")
  tireCondition           String? @map("tire_condition")
  modifications           String? @db.Text
  knownProblems           String? @map("known_problems") @db.Text
  serviceHistory          String? @map("service_history") @db.Text

  registeredOwner      String?  @map("registered_owner")
  ownershipStatus      String?  @map("ownership_status")
  greenBookAvailable   Boolean? @map("green_book_available")
  blueBookAvailable    Boolean? @map("blue_book_available")
  registrationProvince String?  @map("registration_province")
  taxStatus            String?  @map("tax_status")
  insuranceStatus      String?  @map("insurance_status")
  outstandingFinance   String?  @map("outstanding_finance")
  restrictions         String?  @db.Text

  priceNegotiable         Boolean? @map("price_negotiable")
  sellTimeline            String?  @map("sell_timeline")
  reasonForSelling        String?  @map("reason_for_selling") @db.Text
  acceptRecommendedPrice  Boolean? @map("accept_recommended_price")

  yearMin              Int?     @map("year_min")
  yearMax              Int?     @map("year_max")
  budgetMin            Int?     @map("budget_min")
  budgetMax            Int?     @map("budget_max")
  maxMileageKm         Int?     @map("max_mileage_km")
  newOrUsed            String?  @map("new_or_used")
  preferredColour      String?  @map("preferred_colour")
  mustHaveFeatures     String?  @map("must_have_features") @db.Text
  dealBreakers         String?  @map("deal_breakers") @db.Text
  purchasePayment      String?  @map("purchase_payment")
  purchaseTimeframe    String?  @map("purchase_timeframe")
  needDelivery         Boolean? @map("need_delivery")
  needTransfer         Boolean? @map("need_transfer")
  needInsurance        Boolean? @map("need_insurance")
  needInspection       Boolean? @map("need_inspection")
  needFinancingHelp    Boolean? @map("need_financing_help")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lead  VehicleLead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  media VehicleMedia[]

  @@index([make, model, year])
  @@map("vehicles")
}

model VehicleMedia {
  id          String           @id @default(cuid())
  leadId      String           @map("lead_id")
  vehicleId   String?          @map("vehicle_id")
  mediaType   VehicleMediaKind @map("media_type")
  category    String
  name        String
  storageKey  String           @map("storage_key")
  mimeType    String?          @map("mime_type")
  size        Int?
  /// Registration / ID / private docs — never used in social content.
  isPrivate   Boolean          @default(false) @map("is_private")
  createdAt   DateTime         @default(now()) @map("created_at")

  lead    VehicleLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vehicle Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([leadId, category])
  @@map("vehicle_media")
}

model VehicleLeadStatusHistory {
  id          String            @id @default(cuid())
  leadId      String            @map("lead_id")
  fromStatus  VehicleLeadStatus? @map("from_status")
  toStatus    VehicleLeadStatus @map("to_status")
  changedById String?           @map("changed_by_id")
  note        String?
  createdAt   DateTime          @default(now()) @map("created_at")

  lead      VehicleLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy User?       @relation("VehicleLeadStatusActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("vehicle_lead_status_history")
}

model VehicleLeadNote {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  userId    String   @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  lead VehicleLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("vehicle_lead_notes")
}

model VehicleLeadReferralToken {
  id        String    @id @default(cuid())
  token     String    @unique
  staffId   String    @map("staff_id")
  campaign  String?
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  staff User          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  leads VehicleLead[]

  @@index([staffId])
  @@map("vehicle_lead_referral_tokens")
}

model VehicleSocialContent {
  id          String                @id @default(cuid())
  leadId      String                @map("lead_id")
  language    String                @default("en")
  status      VehicleSocialStatus   @default(draft_generated)
  packageJson Json                  @map("package_json")
  approvedAt  DateTime?             @map("approved_at")
  approvedById String?              @map("approved_by_id")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  lead       VehicleLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  approvedBy User?       @relation("VehicleSocialApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("vehicle_social_content")
}

model VehicleSocialPost {
  id        String                 @id @default(cuid())
  leadId    String                 @map("lead_id")
  platform  VehicleSocialPlatform
  postedAt  DateTime?              @map("posted_at")
  postUrl   String?                @map("post_url")
  staffId   String?                @map("staff_id")
  campaign  String?
  notes     String?                @db.Text
  createdAt DateTime               @default(now()) @map("created_at")

  lead  VehicleLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  staff User?       @relation("VehicleSocialPoster", fields: [staffId], references: [id], onDelete: SetNull)

  @@index([leadId, platform])
  @@map("vehicle_social_posts")
}
