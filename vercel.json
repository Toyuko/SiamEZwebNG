{
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/jobs/auto-approve",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/followup-reminders",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/backoffice-report?kind=morning",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/backoffice-report?kind=eod",
      "schedule": "0 12 * * *"
    }
  ]
}
