# Database (PostgreSQL) - Neon example
# Use the pooled connection for the app runtime:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
# Use the direct (non-pooler) connection for prisma migrate deploy:
# Same as DATABASE_URL but without "-pooler" in the hostname.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Optional seed overrides (never use weak defaults in production)
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="use-a-strong-unique-password"
# ALLOW_PRODUCTION_SEED="false"

# Admin: set to "true" to bypass login for /admin (development only — ignored on Vercel)
BYPASS_ADMIN_AUTH=""

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Canonical auth origin. Production: https://siam-ez.com
AUTH_URL="http://localhost:3000"

# Public site origin (no trailing slash). Used for canonicals, sitemap, emails, Open Graph.
# Local: http://localhost:3000
# Vercel Production: https://siam-ez.com
# Vercel Preview: leave unset so the preview deployment URL is used
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Set true on non-production environments that must stay out of Google.
# NEXT_PUBLIC_NOINDEX="true"
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Vercel Cron: auto-approve completed freelancer jobs (Bearer token)
# No leading/trailing spaces or newlines (Vercel rejects whitespace in cron header values).
CRON_SECRET=generate-a-random-secret

# OAuth providers (optional - omit to disable)
# Production callback URLs to register in each provider console:
#   https://siam-ez.com/api/auth/callback/google
#   https://siam-ez.com/api/auth/callback/facebook
#   https://siam-ez.com/api/auth/callback/line
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
# Feature flag: keep Facebook button hidden until review is approved.
AUTH_ENABLE_FACEBOOK="false"
AUTH_LINE_ID=""
AUTH_LINE_SECRET=""

# Stripe (deferred — keep keys empty until you set STRIPE_ENABLED=true)
STRIPE_ENABLED="false"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional: file upload (Vercel Blob or S3) - required for payment proof upload
BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# Real-time job chat (Pusher) - https://pusher.com
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap1"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# Transactional email (Resend) — required for bookings, contact, password reset, job alerts
# Provision via: vercel install resend --plan free -m domain=siam-ez.com -m region=ap-northeast-1
# Or create an API key at https://resend.com and paste it here.
RESEND_API_KEY=""
# Must use a verified domain in production (e.g. SiamEZ <inquiries@siam-ez.com>)
EMAIL_FROM="SiamEZ <inquiries@siam-ez.com>"
EMAIL_REPLY_TO="inquiries@siam-ez.com"
# Ops inbox for contact form + internal alerts (defaults to inquiries@siam-ez.com)
EMAIL_OPS_TO="inquiries@siam-ez.com"

# Optional Zapier/Make/n8n bridge (still fired alongside Resend when set)
CONTACT_FORM_WEBHOOK_URL=""

# AI Concierge / Quote requirement extraction (optional — falls back to rules)
OPENAI_API_KEY=""
# OPENAI_BASE_URL=""
# AI_GATEWAY_API_KEY=""
# VERCEL_AI_GATEWAY_API_KEY=""
# AI_GATEWAY_URL=""
AI_CONCIERGE_MODEL="gpt-4o-mini"
# Smart quote validity window (days)
QUOTE_VALIDITY_DAYS="14"

# Thai payments (required in production — no code defaults)
PROMPTPAY_ID=""
BANK_NAME=""
BANK_BRANCH=""
BANK_ACCOUNT_NAME=""
BANK_ACCOUNT_NUMBER=""
WISE_BENEFICIARY=""
WISE_ACCOUNT_ID=""
WISE_PAY_URL=""
WISE_DETAILS=""
